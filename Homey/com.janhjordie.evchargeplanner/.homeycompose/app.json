{
  "id": "com.janhjordie.evchargeplanner",
  "version": "1.0.32",
  "compatibility": ">=13.0.0",
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "sdk": 3,
  "brandColor": "#1B6B3A",
  "name": {
    "en": "EV Charge Planner",
    "da": "EV Ladeplan"
  },
  "description": {
    "en": "Optimizes EV charging using 15-minute spot prices.",
    "da": "Optimerer elbil-opladning med 15-minutters spotpriser."
  },
  "category": "energy",
  "tags": {
    "en": [
      "ev",
      "charging",
      "spot price",
      "energy"
    ],
    "da": [
      "elbil",
      "opladning",
      "spotpris",
      "energi"
    ]
  },
  "permissions": [
    "homey:manager:api"
  ],
  "api": {
    "validationSummary": {
      "method": "GET",
      "path": "/validation-summary"
    },
    "evaluateAll": {
      "method": "POST",
      "path": "/evaluate-all"
    },
    "createDevice": {
      "method": "POST",
      "path": "/create-device"
    }
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Jan Hjørdie"
  }
}