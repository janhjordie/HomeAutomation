  "capabilitiesOptions": {
    "measure_power": {
      "approximated": true
    }
  },
  "energy": {
    "evCharger": true
  },
  "images": {
    "small": "/drivers/ev_planner/assets/images/small.png",
    "large": "/drivers/ev_planner/assets/images/large.png",
    "xlarge": "/drivers/ev_planner/assets/images/xlarge.png"
  },
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
