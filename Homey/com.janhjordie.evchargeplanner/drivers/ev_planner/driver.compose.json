      "value": 7,
      "min": 1,
      "max": 24,
      "units": {
        "en": "hours",
        "da": "timer"
      }
    },
    {
      "id": "one_shot_ready_by",
      "type": "text",
      "label": {
        "en": "Ready by (HH:mm)",
        "da": "Klar kl. (TT:mm)"
      },
      "value": "09:30"
    }
