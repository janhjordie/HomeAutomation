{
  "name": {
    "en": "EV Charge Planner",
    "da": "EV Ladeplan"
  },
  "class": "evcharger",
  "capabilities": [
    "force_charge",
    "night_charge_enabled",
    "one_shot_enabled",
    "evcharger_charging",
    "measure_power",
    "evcharger_charging_state",
    "charge_now",
    "charge_message",
    "charge_schedule",
    "spot_price",
    "spot_price_quarter",
    "cheapest_plan_only",
    "spot_threshold",
    "charge_hours",
    "one_shot_charge_hours"
  ],
  "capabilitiesOptions": {
    "measure_power": {
      "approximated": true
    },
    "charge_hours": {
      "min": 1,
      "max": 8,
      "step": 1
    },
    "one_shot_charge_hours": {
      "min": 1,
      "max": 8,
      "step": 1
    },
    "spot_threshold": {
      "min": 0.05,
      "max": 2,
      "step": 0.01
    }
  },
  "energy": {
    "evCharger": true
  },
  "images": {
    "small": "/drivers/ev_planner/assets/images/small.png",
    "large": "/drivers/ev_planner/assets/images/large.png",
    "xlarge": "/drivers/ev_planner/assets/images/xlarge.png"
  },
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "id": "charge_hours",
      "type": "number",
      "label": {
        "en": "Charge hours needed",
        "da": "Ladetimer behov"
      },
      "value": 3,
      "min": 1,
      "max": 8,
      "units": {
        "en": "hours",
        "da": "timer"
      }
    },
    {
      "id": "spot_threshold",
      "type": "number",
      "label": {
        "en": "Spot threshold incl. VAT",
        "da": "Spot-grænse inkl. moms"
      },
      "value": 0.30,
      "min": 0.05,
      "max": 2,
      "step": 0.01,
      "units": {
        "en": "kr/kWh",
        "da": "kr/kWh"
      }
    },
    {
      "id": "cheapest_plan_only",
      "type": "checkbox",
      "label": {
        "en": "Cheapest plan only",
        "da": "Kun billigste plan"
      },
      "value": false
    },
    {
      "id": "night_charge_enabled",
      "type": "checkbox",
      "label": {
        "en": "Night charging enabled",
        "da": "Natteopladning aktiv"
      },
      "value": true
    },
    {
      "id": "one_shot_enabled",
      "type": "checkbox",
      "label": {
        "en": "One-shot charge active",
        "da": "Engangsopladning aktiv"
      },
      "value": false
    },
    {
      "id": "one_shot_charge_hours",
      "type": "number",
      "label": {
        "en": "One-shot charge hours",
        "da": "Engangsopladning timer"
      },
      "value": 7,
      "min": 1,
      "max": 8,
      "units": {
        "en": "hours",
        "da": "timer"
      }
    },
    {
      "id": "one_shot_ready_by",
      "type": "text",
      "label": {
        "en": "Ready by (HH:mm)",
        "da": "Klar kl. (TT:mm)"
      },
      "value": "09:30"
    }
  ]
}
