{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.janhjordie.evchargeplanner",
  "version": "1.0.46",
  "compatibility": ">=13.0.0",
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "sdk": 3,
  "brandColor": "#1B6B3A",
  "name": {
    "en": "EV Charge Planner",
    "da": "EV Ladeplan"
  },
  "description": {
    "en": "Optimizes EV charging using 15-minute spot prices.",
    "da": "Optimerer elbil-opladning med 15-minutters spotpriser."
  },
  "category": "energy",
  "tags": {
    "en": [
      "ev",
      "charging",
      "spot price",
      "energy"
    ],
    "da": [
      "elbil",
      "opladning",
      "spotpris",
      "energi"
    ]
  },
  "permissions": [
    "homey:manager:api"
  ],
  "api": {
    "validationSummary": {
      "method": "GET",
      "path": "/validation-summary"
    },
    "evaluateAll": {
      "method": "POST",
      "path": "/evaluate-all"
    },
    "createDevice": {
      "method": "POST",
      "path": "/create-device"
    }
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Jan Hjørdie"
  },
  "flow": {
    "triggers": [
      {
        "id": "plan_updated",
        "title": {
          "en": "Charge plan updated",
          "da": "Ladeplan opdateret"
        },
        "titleFormatted": {
          "en": "Charge plan updated: [[charge_message]]",
          "da": "Ladeplan opdateret: [[charge_message]]"
        },
        "tokens": [
          {
            "name": "charge_message",
            "type": "string",
            "title": {
              "en": "Message",
              "da": "Besked"
            }
          },
          {
            "name": "charge_schedule",
            "type": "string",
            "title": {
              "en": "Schedule",
              "da": "Plan"
            }
          },
          {
            "name": "spot_price",
            "type": "number",
            "title": {
              "en": "Current spot price",
              "da": "Aktuel spotpris"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=ev_planner"
          }
        ]
      },
      {
        "id": "price_api_error",
        "title": {
          "en": "Price API failed",
          "da": "Pris-API fejlede"
        },
        "tokens": [
          {
            "name": "error_message",
            "type": "string",
            "title": {
              "en": "Error",
              "da": "Fejl"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=ev_planner"
          }
        ]
      },
      {
        "id": "charge_started",
        "title": {
          "en": "Charging started",
          "da": "Opladning startet"
        },
        "titleFormatted": {
          "en": "Charging started: [[charge_message]]",
          "da": "Opladning startet: [[charge_message]]"
        },
        "tokens": [
          {
            "name": "charge_message",
            "type": "string",
            "title": {
              "en": "Message",
              "da": "Besked"
            }
          },
          {
            "name": "charge_schedule",
            "type": "string",
            "title": {
              "en": "Schedule",
              "da": "Plan"
            }
          },
          {
            "name": "spot_price",
            "type": "number",
            "title": {
              "en": "Current spot price",
              "da": "Aktuel spotpris"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=ev_planner"
          }
        ]
      },
      {
        "id": "charge_stopped",
        "title": {
          "en": "Charging stopped",
          "da": "Opladning stoppet"
        },
        "titleFormatted": {
          "en": "Charging stopped: [[charge_message]]",
          "da": "Opladning stoppet: [[charge_message]]"
        },
        "tokens": [
          {
            "name": "charge_message",
            "type": "string",
            "title": {
              "en": "Message",
              "da": "Besked"
            }
          },
          {
            "name": "charge_schedule",
            "type": "string",
            "title": {
              "en": "Schedule",
              "da": "Plan"
            }
          },
          {
            "name": "spot_price",
            "type": "number",
            "title": {
              "en": "Current spot price",
              "da": "Aktuel spotpris"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=ev_planner"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "should_charge",
        "title": {
          "en": "!{{Should|Should not}} charge now",
          "da": "!{{Skal|Skal ikke}} lade nu"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=ev_planner"
          }
        ]
      },
      {
        "id": "force_charge_active",
        "title": {
          "en": "Force charge !{{is|is not}} active",
          "da": "Tvungen opladning !{{er|er ikke}} aktiv"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=ev_planner"
          }
        ]
      },
      {
        "id": "night_charge_active",
        "title": {
          "en": "Night charging !{{is|is not}} enabled",
          "da": "Natteopladning !{{er|er ikke}} aktiv"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=ev_planner"
          }
        ]
      },
      {
        "id": "one_shot_active",
        "title": {
          "en": "One-shot charge !{{is|is not}} active",
          "da": "Engangsopladning !{{er|er ikke}} aktiv"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=ev_planner"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "force_charge_on",
        "title": {
          "en": "Start force charge (daytime)",
          "da": "Start tvungen opladning (dag)"
        },
        "highlight": true,
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=ev_planner"
          }
        ]
      },
      {
        "id": "force_charge_off",
        "title": {
          "en": "Stop force charge",
          "da": "Stop tvungen opladning"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=ev_planner"
          }
        ]
      },
      {
        "id": "start_one_shot",
        "title": {
          "en": "Start one-shot charge",
          "da": "Start engangsopladning"
        },
        "titleFormatted": {
          "en": "Start one-shot charge: [[hours]]h ready by [[ready_by]]",
          "da": "Start engangsopladning: [[hours]]t klar [[ready_by]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=ev_planner"
          },
          {
            "name": "hours",
            "type": "number",
            "title": {
              "en": "Hours",
              "da": "Timer"
            }
          },
          {
            "name": "ready_by",
            "type": "text",
            "title": {
              "en": "Ready by (HH:mm)",
              "da": "Klar kl. (TT:mm)"
            }
          }
        ]
      },
      {
        "id": "cancel_one_shot",
        "title": {
          "en": "Cancel one-shot charge",
          "da": "Afbryd engangsopladning"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=ev_planner"
          }
        ]
      },
      {
        "id": "recalculate_now",
        "title": {
          "en": "Recalculate charge plan now",
          "da": "Genberegn ladeplan nu"
        },
        "highlight": true,
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=ev_planner"
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "EV Charge Planner",
        "da": "EV Ladeplan"
      },
      "class": "evcharger",
      "capabilities": [
        "force_charge",
        "night_charge_enabled",
        "one_shot_enabled",
        "evcharger_charging",
        "measure_power",
        "evcharger_charging_state",
        "charge_now",
        "charge_message",
        "charge_schedule",
        "spot_price",
        "spot_price_quarter",
        "cheapest_plan_only",
        "spot_threshold",
        "charge_hours",
        "one_shot_charge_hours",
        "night_charge_end"
      ],
      "capabilitiesOptions": {
        "measure_power": {
          "approximated": true
        },
        "charge_hours": {
          "min": 1,
          "max": 8,
          "step": 1
        },
        "one_shot_charge_hours": {
          "min": 1,
          "max": 8,
          "step": 1
        },
        "night_charge_end": {
          "min": 4,
          "max": 10,
          "step": 0.5
        },
        "spot_threshold": {
          "min": 0.05,
          "max": 2,
          "step": 0.01
        }
      },
      "energy": {
        "evCharger": true
      },
      "images": {
        "small": "/drivers/ev_planner/assets/images/small.png",
        "large": "/drivers/ev_planner/assets/images/large.png",
        "xlarge": "/drivers/ev_planner/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "id": "charge_hours",
          "type": "number",
          "label": {
            "en": "Charge hours needed",
            "da": "Ladetimer behov"
          },
          "value": 3,
          "min": 1,
          "max": 8,
          "units": {
            "en": "hours",
            "da": "timer"
          }
        },
        {
          "id": "spot_threshold",
          "type": "number",
          "label": {
            "en": "Spot threshold incl. VAT",
            "da": "Spot-grænse inkl. moms"
          },
          "value": 0.3,
          "min": 0.05,
          "max": 2,
          "step": 0.01,
          "units": {
            "en": "kr/kWh",
            "da": "kr/kWh"
          }
        },
        {
          "id": "cheapest_plan_only",
          "type": "checkbox",
          "label": {
            "en": "Cheapest plan only",
            "da": "Kun billigste plan"
          },
          "value": false
        },
        {
          "id": "night_charge_enabled",
          "type": "checkbox",
          "label": {
            "en": "Night charging enabled",
            "da": "Natteopladning aktiv"
          },
          "value": true
        },
        {
          "id": "night_charge_end",
          "type": "number",
          "label": {
            "en": "Night window end",
            "da": "Nat-sluttid"
          },
          "value": 6,
          "min": 4,
          "max": 10,
          "step": 0.5,
          "units": {
            "en": "h",
            "da": "t"
          }
        },
        {
          "id": "one_shot_enabled",
          "type": "checkbox",
          "label": {
            "en": "One-shot charge active",
            "da": "Engangsopladning aktiv"
          },
          "value": false
        },
        {
          "id": "one_shot_charge_hours",
          "type": "number",
          "label": {
            "en": "One-shot charge hours",
            "da": "Engangsopladning timer"
          },
          "value": 7,
          "min": 1,
          "max": 8,
          "units": {
            "en": "hours",
            "da": "timer"
          }
        },
        {
          "id": "one_shot_ready_by",
          "type": "text",
          "label": {
            "en": "Ready by (HH:mm)",
            "da": "Klar kl. (TT:mm)"
          },
          "value": "09:30"
        }
      ],
      "id": "ev_planner"
    }
  ],
  "capabilities": {
    "charge_hours": {
      "type": "number",
      "title": {
        "en": "Charge hours needed",
        "da": "Ladetimer behov"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "slider",
      "min": 1,
      "max": 8,
      "step": 1,
      "decimals": 0,
      "units": {
        "en": "h",
        "da": "t"
      }
    },
    "charge_message": {
      "type": "string",
      "title": {
        "en": "Charge message",
        "da": "Ladebesked"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    },
    "charge_now": {
      "type": "boolean",
      "title": {
        "en": "Charge now",
        "da": "Lad nu"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg"
    },
    "charge_schedule": {
      "type": "string",
      "title": {
        "en": "Charge schedule",
        "da": "Ladeplan"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    },
    "cheapest_plan_only": {
      "type": "boolean",
      "title": {
        "en": "Cheapest plan only",
        "da": "Kun billigste plan"
      },
      "hint": {
        "en": "When on, charging only happens in the cheapest planned slots. When off, charging also starts whenever spot is below the threshold.",
        "da": "Når slået til, lades kun i de billigste planlagte kvarter. Når slået fra, startes opladning også når spot er under grænsen."
      },
      "getable": true,
      "setable": true,
      "uiComponent": "toggle"
    },
    "force_charge": {
      "type": "boolean",
      "title": {
        "en": "Force charge",
        "da": "Tvungen opladning"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "toggle",
      "uiQuickAction": true
    },
    "night_charge_enabled": {
      "type": "boolean",
      "title": {
        "en": "Night charging",
        "da": "Natteopladning"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "toggle"
    },
    "night_charge_end": {
      "type": "number",
      "title": {
        "en": "Night end time",
        "da": "Nat-sluttid"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "slider",
      "min": 4,
      "max": 10,
      "step": 0.5,
      "decimals": 1,
      "units": {
        "en": "h",
        "da": "t"
      }
    },
    "one_shot_charge_hours": {
      "type": "number",
      "title": {
        "en": "One-shot charge hours",
        "da": "Engangsopladning timer"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "slider",
      "min": 1,
      "max": 8,
      "step": 1,
      "decimals": 0,
      "units": {
        "en": "h",
        "da": "t"
      }
    },
    "one_shot_enabled": {
      "type": "boolean",
      "title": {
        "en": "One-shot charge",
        "da": "Engangsopladning"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "toggle"
    },
    "spot_price": {
      "type": "number",
      "title": {
        "en": "Spot price",
        "da": "Spotpris"
      },
      "hint": {
        "en": "Current 15-minute spot price including VAT.",
        "da": "Aktuel 15-minutters spotpris inkl. moms."
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "decimals": 2,
      "units": {
        "en": "kr/kWh",
        "da": "kr/kWh"
      }
    },
    "spot_price_quarter": {
      "type": "string",
      "title": {
        "en": "Spot price quarter",
        "da": "Spotpris kvarter"
      },
      "hint": {
        "en": "Current 15-minute price interval (HH:mm).",
        "da": "Aktuelt 15-minutters prisinterval (TT:mm)."
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    },
    "spot_threshold": {
      "type": "number",
      "title": {
        "en": "Spot threshold",
        "da": "Spot-grænse"
      },
      "hint": {
        "en": "Charge immediately when spot price is below this limit (only when cheapest plan only is off).",
        "da": "Lad med det samme når spotprisen er under denne grænse (kun når kun billigste plan er slået fra)."
      },
      "getable": true,
      "setable": true,
      "uiComponent": "slider",
      "min": 0.05,
      "max": 2,
      "step": 0.01,
      "decimals": 2,
      "units": {
        "en": "kr/kWh",
        "da": "kr/kWh"
      }
    }
  }
}