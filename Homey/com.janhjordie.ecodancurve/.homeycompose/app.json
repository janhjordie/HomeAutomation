{
  "id": "com.janhjordie.ecodancurve",
  "version": "0.1.21",
  "compatibility": ">=13.0.0",
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "sdk": 3,
  "brandColor": "#0B4F6C",
  "name": {
    "en": "Ecodan Curve",
    "da": "Ecodan kurve"
  },
  "description": {
    "en": "Weather-compensated flow temperature for Mitsubishi Ecodan via MELCloud (mecloud).",
    "da": "Vejrkompenseret fremløbstemperatur til Mitsubishi Ecodan via MELCloud (mecloud)."
  },
  "category": "climate",
  "tags": {
    "en": [
      "heat pump",
      "ecodan",
      "mitsubishi",
      "weather compensation"
    ],
    "da": [
      "varmepumpe",
      "ecodan",
      "mitsubishi",
      "vejrkompensering"
    ]
  },
  "permissions": [
    "homey:manager:api"
  ],
  "api": {
    "evaluateAll": {
      "method": "POST",
      "path": "/evaluate-all"
    },
    "probeHeatpump": {
      "method": "GET",
      "path": "/probe-heatpump"
    }
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Jan Hjørdie"
  }
}