      "type": "number",
      "title": {
        "en": "Outdoor temp (filtered)",
        "da": "Udetemp (filtreret)"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "units": {
        "en": "°C",
        "da": "°C"
      },
      "decimals": 1
    },
    "outdoor_temp_raw": {
      "type": "number",
      "title": {
        "en": "Outdoor temp (raw)",
        "da": "Udetemp (rå)"
      },
      "getable": true,
