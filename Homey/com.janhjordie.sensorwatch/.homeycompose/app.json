{
  "id": "com.janhjordie.sensorwatch",
  "version": "0.1.18",
  "compatibility": ">=13.0.0",
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "sdk": 3,
  "brandColor": "#5C6BC0",
  "name": {
    "en": "Sensor Watch",
    "da": "Sensor Watch"
  },
  "description": {
    "en": "Monitors Zigbee nodes (lumi.weather, lumi.sensor*) via Homey's node list lastSeen — alerts when a node goes silent.",
    "da": "Overvåger Zigbee-noder (lumi.weather, lumi.sensor*) via Homeys node-liste lastSeen — alarm når en node bliver stille."
  },
  "category": "tools",
  "tags": {
    "en": [
      "aqara",
      "xiaomi",
      "battery",
      "sensor"
    ],
    "da": [
      "aqara",
      "xiaomi",
      "batteri",
      "sensor"
    ]
  },
  "permissions": [
    "homey:manager:api"
  ],
  "api": {
    "status": {
      "method": "GET",
      "path": "/status"
    },
    "checkNow": {
      "method": "POST",
      "path": "/check-now"
    },
    "testPush": {
      "method": "POST",
      "path": "/test-push"
    },
    "setDeviceEnabled": {
      "method": "POST",
      "path": "/device-enabled"
    }
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Jan Hjørdie"
  }
}
